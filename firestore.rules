rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /slots/{slotId} {
      allow get: if true;
      // Cost-abuse guard: anonymous list queries must carry an explicit limit
      // so a single request can never bill the whole collection. Every shipped
      // client query uses limit <= 120 (see src/lib/slots.ts); admins keep
      // unbounded lists for wipe/reseed/fee tooling. A query with no limit
      // fails the null check and is denied.
      allow list: if (request.query.limit != null && request.query.limit <= 150) || isAdmin();
      allow write: if isAdmin();
    }

    // public/ and config/ hold well-known single docs (tokenStats, liveStream,
    // vodPlaylist, emergencyOverride, scheduleMeta, ticker) — clients only ever
    // read them by ID, so collection listing stays off.
    match /public/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // config/ticker feeds the OBS broadcast ticker overlay
    // (docs/obs/csgn-ticker.html), which polls it unauthenticated over the
    // public Firestore REST API — read is deliberately fully public. Writes
    // (Admin panel headline rail + coin spotlight) stay admin-only.
    match /config/ticker {
      allow read: if true;
      allow write: if isAdmin();
    }

    // votes/{voteId} holds the aggregate tally (tokens + distinct-wallet count
    // per option), updated atomically by the castVote function (firebase-admin,
    // which bypasses these rules). Public read powers the scoreboard and the
    // on-air overlay; admins create/reset a vote from the panel. Individual
    // ballots (votes/{id}/ballots/{wallet}) have no rule → server-only.
    match /votes/{voteId} {
      allow get: if true;
      // Public reads are per-vote (the live scoreboard knows its own id).
      // Only the admin panel enumerates the collection, for vote history.
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin();

      // A member may touch exactly ONE field of their own document —
      // `notifications` — and nothing else, ever. Everything that decides what
      // an account can do (role, status, phantom, twitch, slotLimits, username)
      // stays server-only, so this cannot become a privilege-escalation path:
      // the `hasOnly` check rejects the whole write if any other key changes.
      //
      // Without this, dismissing a notification or marking one read was denied
      // by the rules and swallowed by the client's catch — the buttons simply
      // did nothing for every non-admin member, silently, forever.
      //
      // The size cap is a cost guard, not a correctness one: the array lives on
      // a doc the member can rewrite, so it needs a ceiling or it becomes free
      // storage that every profile read then pays to transfer.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifications'])
          && request.resource.data.notifications.size() <= 50
        );

      allow delete: if isAdmin();
    }

    match /uniqueEmails/{docId} { allow read, write: if isAdmin(); }
    match /uniqueUsernames/{docId} { allow read, write: if isAdmin(); }
    match /uniquePhantomWallets/{docId} { allow read, write: if isAdmin(); }
    match /uniqueTwitchUsers/{docId} { allow read, write: if isAdmin(); }
    match /oauthStates/{docId} { allow read, write: if isAdmin(); }
    match /twitchOAuthResults/{docId} { allow read, write: if false; }
    match /phantomChallenges/{docId} { allow read, write: if isAdmin(); }
    match /auditLogs/{docId} { allow read, write: if isAdmin(); }

    match /applications/{appId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Written ONLY by the logAuthEvent function (firebase-admin bypasses rules).
    // Browser writes are off: the events worth having fire before a session
    // exists (signin-start / signin-failure / signup-email-start), so a
    // `create: if isSignedIn()` rule silently dropped exactly those and left the
    // admin's Auth Events tab looking empty during failed sign-ups.
    match /auth_events/{eventId} {
      allow create: if false;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
