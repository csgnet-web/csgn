VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase App Check (reCAPTCHA v3). Leave unset to disable App Check locally.
# Site key: Firebase console > App Check > register web app.
VITE_FIREBASE_APPCHECK_SITE_KEY=your_recaptcha_v3_site_key
# Optional: a debug token registered in the console, for local dev / CI once
# App Check enforcement is enabled.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

VITE_TWITCH_CLIENT_ID=your_twitch_client_id
VITE_X_CLIENT_ID=your_x_oauth2_client_id
X_CLIENT_ID=your_x_oauth2_client_id
X_CLIENT_SECRET=your_x_oauth2_client_secret

# Wallet-only sign-up sybil gate: lamports a wallet must hold to register on
# balance alone (default 1_000_000 = 0.001 SOL). Any on-chain history clears the
# gate regardless of balance. Set higher to make mass registration costlier.
CSGN_SIGNUP_MIN_LAMPORTS=1000000

# ── THE RIGHT NOW RAIL, WRITTEN AUTOMATICALLY ────────────────────────────────
# Server-side only. Every two hours a model reads what crypto is talking about
# and writes a few short lines for the ticker's Right Now rail. Every line is
# vetted in code before it can reach the broadcast — see
# netlify/functions/_shared/rightNow.ts.

# REQUIRED for the writer to run at all. Without it the scheduled function
# exits immediately and the rail keeps whatever holders have put on it.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5. The job is a handful of short lines
# twelve times a day, so this is single-digit dollars a month — set it only if
# you want a different voice, not to save money.
CSGN_RAIL_MODEL=

# OPTIONAL, and it is a real bill. Reading a timeline you do not own needs X's
# recent-search endpoint, which starts at their Basic tier. An app-only bearer
# from the X developer portal. WITHOUT IT the rail still updates — it writes
# from the channel's own Meme 100 market board instead, at no extra cost.
X_BEARER_TOKEN=

# Optional. Overrides what the rail reads from X. Standard X search syntax, so
# this can be a list of accounts (from:someone OR from:someoneelse), a cashtag,
# or your own community. Default: crypto/solana/memecoin, English, originals
# only, no links.
X_RAIL_QUERY=

# ── TIKTOK ───────────────────────────────────────────────────────────────────
# Login Kit + Display API. Server-side only. TIKTOK_REDIRECT_URI must point at
# the FUNCTION (…/.netlify/functions/tiktokOAuthCallback) and must be registered
# byte-for-byte in the TikTok developer console.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
